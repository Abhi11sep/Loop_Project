datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ANALYST") // ADMIN, ANALYST, VIEWER
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports      Report[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String // Support ticket, App store review, NPS survey, Sales call note, Community post
  customerLabel  String?
  sourceRef      String?
  sentiment      String          @default("NEU") // POS, NEU, NEG
  sentimentScore Float           @default(0.0) // -1.0 to 1.0
  status         String          @default("NEW") // NEW, REVIEWED, ACTIONED
  featureArea    String?
  rationale      String?
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbackThemes FeedbackTheme[]
  embedding      Embedding?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Theme {
  id             String          @id @default(cuid())
  name           String
  description    String?
  color          String?         @default("#6366f1")
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbackThemes FeedbackTheme[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float    @default(1.0)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vectorJson String // JSON serialized array of vector values or tf-idf term weights
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Report {
  id            String    @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   String // JSON storing top complaints, top features, sentiment changes, verbatim quotes, recommendations
  generatedById String
  generatedBy   User      @relation(fields: [generatedById], references: [id])
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}
